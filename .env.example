# Database Credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret

# Shared Security
JWT_SECRET=your_jwt_secret_here

# Internal Port for all backend services
PORT=3000

# Development Host Ports
AUTH_DEV_PORT=3001
PRODUCT_DEV_PORT=3002
ORDER_DEV_PORT=3003

# Service URLs for Local Development
DEV_AUTH_URL=http://localhost:3001
DEV_PRODUCT_URL=http://localhost:3002
DEV_ORDER_URL=http://localhost:3003

# Service URLs for Production
PROD_AUTH_URL=http://auth-service:3000
PROD_PRODUCT_URL=http://product-service:3000
PROD_ORDER_URL=http://order-service:3000

# Database URLs
AUTH_DATABASE_URL=postgresql://admin:secret@localhost:5432/auth_db
PRODUCT_DATABASE_URL=postgresql://admin:secret@localhost:5432/product_db
ORDER_DATABASE_URL=postgresql://admin:secret@localhost:5432/order_db
